# =============================================================
# ZW Ecosystem — Server Environment Variables
# =============================================================
# IMPORTANT: This file MUST NEVER be committed to Git.
# It is listed in .gitignore.
# Copy this file to .env on the server and fill real values.
# =============================================================

# --- Database ---
POSTGRES_DB=zwecodb
POSTGRES_USER=zw_user
POSTGRES_PASSWORD=YOUR_STRONG_DB_PASSWORD_HERE

# --- Backend App (ASP.NET Core reads these) ---
DB_CONNECTION_STRING=Host=zwecosystem-postgres;Port=5432;Database=zwecodb;Username=zw_user;Password=YOUR_STRONG_DB_PASSWORD_HERE;Include Error Detail=true;

# --- JWT ---
JWT_SECRET=YOUR_MINIMUM_32_CHARACTER_JWT_SECRET_HERE_CHANGE_THIS

# --- Redis ---
# Runs standalone on the VPS host (installed directly, NOT a docker
# container) so it survives every deploy/redeploy untouched — uploaded
# images live only in Redis (see UploadController/ImagesController), so
# losing it would mean losing every image again. REDIS_HOST is the host's
# own address (backend can't reach it as "localhost" from inside its
# container). Must match the values baked into backend/appsettings.json's
# ConnectionStrings:Redis for local dev to connect to the same instance.
REDIS_HOST=194.5.152.74
REDIS_PASSWORD=YOUR_STRONG_REDIS_PASSWORD_HERE

# --- SMTP (Optional - for email OTP etc.) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password
SMTP_FROM=noreply@zwecosystem.com
